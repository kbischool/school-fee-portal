rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Any administrator (owner OR staff).
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // The owner: the ONLY account that sees money, codes and the full dashboard.
    // owners/{uid} can only be created by hand in the Firebase console (no client
    // write is allowed below), so nobody can promote themselves.
    function isOwner() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/owners/$(request.auth.uid));
    }

    function isLinkedParent(studentId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/parents/$(request.auth.uid)) &&
        studentId in get(/databases/$(database)/documents/parents/$(request.auth.uid)).data.linkedStudents;
    }

    // owners/{uid} — you can read only your own marker; nobody can write from the client.
    match /owners/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // students/{id} — the full fee records (amounts, itemised charges).
    // Owner and the linked parent only. Staff admins can NOT read this.
    match /students/{studentId} {
      allow read: if isOwner() || isLinkedParent(studentId);
      allow write: if isOwner();
    }

    // studentStatus/{id} — name, class and a paid / part / unpaid label per term.
    // NO amounts. Any admin can read it; only the owner can write.
    match /studentStatus/{studentId} {
      allow read: if isAdmin();
      allow write: if isOwner();
    }

    // parents/{uid} — a parent's own profile + which students they are linked to.
    match /parents/{uid} {
      allow read: if isOwner() || (isSignedIn() && request.auth.uid == uid);
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isOwner() || (isSignedIn() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedStudents']));
    }

    // admins/{uid} — admin profiles.
    // Creating one now REQUIRES a real, still-unclaimed admin code (claimedFrom),
    // so a parent (or anyone signed in) can no longer make themselves an admin.
    match /admins/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list: if isOwner();
      allow create: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.claimedFrom is string &&
        exists(/databases/$(database)/documents/adminCodes/$(request.resource.data.claimedFrom)) &&
        get(/databases/$(database)/documents/adminCodes/$(request.resource.data.claimedFrom)).data.claimed == false;
      allow update, delete: if isOwner();
    }

    // schoolCodes/{code} — parent first-login codes. Only the owner can browse/create/delete.
    match /schoolCodes/{code} {
      allow get: if true;
      allow list: if isOwner();
      allow create: if isOwner();
      allow update: if isOwner() || (
        isSignedIn() &&
        resource.data.claimed == false &&
        request.resource.data.claimed == true &&
        request.resource.data.claimedByUid == request.auth.uid
      );
      allow delete: if isOwner();
    }

    // adminCodes/{code} — administrator onboarding codes. Only the owner issues them.
    match /adminCodes/{code} {
      allow get: if true;
      allow list: if isOwner();
      allow create: if isOwner();
      allow update: if isOwner() || (
        isSignedIn() &&
        resource.data.claimed == false &&
        request.resource.data.claimed == true &&
        request.resource.data.claimedByUid == request.auth.uid
      );
      allow delete: if isOwner();
    }
  }
}
