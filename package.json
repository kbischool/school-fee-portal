{
  "name": "kbis-portal",
  "version": "2.0.0",
  "private": true,
  "description": "KBIS fee portal - static site on Firebase Hosting + Firestore",
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:rules",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:rules": "firebase emulators:exec --only firestore --project demo-kbis \"node --test \\\"tests/rules/*.test.js\\\"\"",
    "test:e2e": "node tests/e2e/run.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.12.2",
    "firebase-tools": "^13.35.1",
    "playwright": "^1.48.0",
    "xlsx": "0.18.5"
  }
}
